---
// PROTOTYPE (#6) — throwaway. Variant C "CTA-forward":
// Hero with a prominent button row → Pillars → Code → footer.
// No closing band; the ask happens once, up front.
import Pillars from '../Pillars.astro';
import CodeSample from './CodeSample.astro';
---

<header class="hero">
  <h1>Your enterprise domain model, as code.</h1>
  <p class="subhead">
    Heirloom is an open-source, self-hosted ontology layer: data, actions,
    logic, and security — defined once in TypeScript.
  </p>
  <div class="cta-row">
    <a class="cta-button" href="https://github.com/0xnicholas/heirloom-pro">
      View on GitHub
    </a>
    <a class="cta-ghost" href="https://github.com/0xnicholas/heirloom-pro">
      Read the spec
    </a>
  </div>
</header>

<section>
  <Pillars />
</section>

<section>
  <CodeSample />
</section>

<footer>
  <p>
    Heirloom is in design; the spec is public on{' '}
    <a href="https://github.com/0xnicholas/heirloom-pro">GitHub</a>. Apache-2.0.
  </p>
</footer>

<style>
  .cta-row {
    margin-top: 2rem;
    display: flex;
    gap: 0.9rem;
    align-items: center;
  }
  .cta-button {
    display: inline-block;
    background: var(--accent);
    color: #fcfcfa;
    padding: 0.7rem 1.6rem;
    border-radius: 8px;
    font-size: 0.95rem;
  }
  .cta-button:hover {
    text-decoration: none;
    opacity: 0.92;
  }
  .cta-ghost {
    display: inline-block;
    border: 1px solid var(--ink);
    color: var(--ink);
    padding: 0.7rem 1.6rem;
    border-radius: 8px;
    font-size: 0.95rem;
  }
  .cta-ghost:hover {
    text-decoration: none;
    background: #ffffff;
  }
</style>
