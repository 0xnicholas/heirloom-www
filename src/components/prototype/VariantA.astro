---
// PROTOTYPE (#5) — throwaway. Variant A: radial hub diagram.
// Four pillar nodes around a central ontology hub, plain SVG.
---

<figure class="radial">
  <svg viewBox="0 0 660 420" role="img" aria-label="Four pillars around one ontology">
    <line class="edge" x1="330" y1="210" x2="330" y2="92" />
    <line class="edge" x1="330" y1="210" x2="537" y2="210" />
    <line class="edge" x1="330" y1="210" x2="330" y2="328" />
    <line class="edge" x1="330" y1="210" x2="123" y2="210" />

    <g class="hub">
      <rect x="235" y="172" width="190" height="76" rx="10" />
      <text class="hub-label" x="330" y="206">ONTOLOGY</text>
      <text class="hub-sub" x="330" y="228">defined once in TypeScript</text>
    </g>

    <g class="node">
      <rect x="235" y="28" width="190" height="64" rx="10" />
      <text class="node-label" x="330" y="56">DATA</text>
      <text class="node-sub" x="330" y="76">entities &amp; links, modeled once</text>
    </g>
    <g class="node">
      <rect x="442" y="178" width="190" height="64" rx="10" />
      <text class="node-label" x="537" y="206">ACTIONS</text>
      <text class="node-sub" x="537" y="226">the only write path</text>
    </g>
    <g class="node">
      <rect x="235" y="328" width="190" height="64" rx="10" />
      <text class="node-label" x="330" y="356">LOGIC</text>
      <text class="node-sub" x="330" y="376">read functions over the model</text>
    </g>
    <g class="node">
      <rect x="28" y="178" width="190" height="64" rx="10" />
      <text class="node-label" x="123" y="206">SECURITY</text>
      <text class="node-sub" x="123" y="226">fails closed by default</text>
    </g>
  </svg>
</figure>

<style>
  .radial {
    margin: 0;
  }
  .edge {
    stroke: var(--rule);
    stroke-width: 1.5;
  }
  .hub rect {
    fill: var(--accent);
  }
  .hub-label {
    fill: #fcfcfa;
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.08em;
    text-anchor: middle;
  }
  .hub-sub {
    fill: #d9d7f8;
    font-size: 11px;
    text-anchor: middle;
  }
  .node rect {
    fill: #ffffff;
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .node-label {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-anchor: middle;
  }
  .node-sub {
    fill: var(--ink-muted);
    font-size: 10.5px;
    text-anchor: middle;
  }
</style>
