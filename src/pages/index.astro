---
import '../styles/global.css';
import FullPagePrototype from '../components/prototype/FullPagePrototype.astro';

const title = 'Heirloom — Your enterprise domain model, as code.';
const description =
  'Heirloom is an open-source, self-hosted ontology layer: data, actions, logic, and security — defined once in TypeScript.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <!-- PROTOTYPE (#6): three full-page assemblies, switch via ?variant=A|B|C -->
    <FullPagePrototype />
  </body>
</html>
